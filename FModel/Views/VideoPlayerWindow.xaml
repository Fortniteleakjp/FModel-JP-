<adonisControls:AdonisWindow x:Class="FModel.Views.VideoPlayerWindow"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
                             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                             WindowStartupLocation="CenterScreen" ResizeMode="CanResize" IconVisibility="Collapsed"
                             Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown"
                             Height="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenHeight}, Converter={converters:RatioConverter}, ConverterParameter='0.6'}"
                             Width="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenWidth}, Converter={converters:RatioConverter}, ConverterParameter='0.55'}">
    <adonisControls:AdonisWindow.Style>
        <Style TargetType="adonisControls:AdonisWindow" BasedOn="{StaticResource {x:Type adonisControls:AdonisWindow}}">
            <Setter Property="Title" Value="{DynamicResource UI_VideoPlayer}" />
        </Style>
    </adonisControls:AdonisWindow.Style>

    <DockPanel>
        <!-- 操作バー: 再生/一時停止・停止・シーク・時間・音量・保存/外部で開く -->
        <Grid DockPanel.Dock="Bottom" Margin="10 6 10 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <Slider x:Name="SeekSlider" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" Minimum="0" Maximum="1" IsEnabled="False"
                    IsMoveToPointEnabled="True" Margin="0 0 0 6" ValueChanged="OnSeekChanged" />

            <Button x:Name="PlayPauseButton" Grid.Row="1" Grid.Column="0" Width="32" Height="28" Padding="0" IsEnabled="False"
                    Click="OnPlayPauseClick" ToolTip="{DynamicResource UI_VideoPlayer_PlayPause}">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="PlayPauseIcon" Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource PlayIcon}" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button x:Name="StopButton" Grid.Row="1" Grid.Column="1" Width="32" Height="28" Padding="0" Margin="4 0 0 0" IsEnabled="False"
                    Click="OnStopClick" ToolTip="{DynamicResource UI_VideoPlayer_Stop}">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource StopIcon}" />
                    </Canvas>
                </Viewbox>
            </Button>

            <TextBlock x:Name="TimeText" Grid.Row="1" Grid.Column="2" Margin="10 0" VerticalAlignment="Center" Text="00:00 / 00:00" />

            <Button Grid.Row="1" Grid.Column="3" Height="28" Padding="10 0" Margin="0 0 4 0" Click="OnSaveClick"
                    Content="{DynamicResource UI_VideoPlayer_Save}" />
            <Button Grid.Row="1" Grid.Column="4" Height="28" Padding="10 0" Margin="0 0 10 0" Click="OnOpenExternalClick"
                    Content="{DynamicResource UI_VideoPlayer_OpenExternal}" />
            <Slider x:Name="VolumeSlider" Grid.Row="1" Grid.Column="5" Minimum="0" Maximum="100" VerticalAlignment="Center"
                    ValueChanged="OnVolumeChanged" ToolTip="{DynamicResource UI_VideoPlayer_Volume}" />
        </Grid>

        <Grid Background="Black">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform"
                          MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed"
                          MouseLeftButtonUp="OnVideoClick" />
            <!-- webm 等、MediaElement で開けない動画用 (StartWeb で表示する) -->
            <wv2:WebView2 x:Name="WebPlayer" Visibility="Collapsed" />
            <TextBlock x:Name="MessageText" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="20"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</adonisControls:AdonisWindow>
