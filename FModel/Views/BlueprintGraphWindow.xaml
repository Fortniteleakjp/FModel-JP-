<adonisControls:AdonisWindow x:Class="FModel.Views.BlueprintGraphWindow"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"

                             xmlns:viewModels="clr-namespace:FModel.ViewModels"
                             xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
                             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
                             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"

                             WindowStartupLocation="CenterScreen" ResizeMode="CanResize" IconVisibility="Collapsed"
                             Height="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenHeight}, Converter={converters:RatioConverter}, ConverterParameter='0.8'}"
                             Width="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenWidth}, Converter={converters:RatioConverter}, ConverterParameter='0.88'}">
    <adonisControls:AdonisWindow.Style>
        <Style TargetType="adonisControls:AdonisWindow" BasedOn="{StaticResource {x:Type adonisControls:AdonisWindow}}">
            <Setter Property="Title" Value="{DynamicResource UI_BlueprintGraph}" />
        </Style>
    </adonisControls:AdonisWindow.Style>

    <adonisControls:AdonisWindow.Resources>
        <!-- header strip colour per node kind, close to the editor's palette -->
        <Style x:Key="NodeHeader" TargetType="Border">
            <Setter Property="CornerRadius" Value="4 4 0 0" />
            <Setter Property="Padding" Value="8 2" />
            <Setter Property="Background" Value="#FF4A4F57" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Event">
                    <Setter Property="Background" Value="#FF9C2A2A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="FunctionEntry">
                    <Setter Property="Background" Value="#FF6B3FA0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Call">
                    <Setter Property="Background" Value="#FF2F5E9E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Latent">
                    <Setter Property="Background" Value="#FF2E7F86" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Pure">
                    <Setter Property="Background" Value="#FF3D7A3D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Set">
                    <Setter Property="Background" Value="#FF4F5B66" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Get">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Cast">
                    <Setter Property="Background" Value="#FF008C9E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Timeline">
                    <Setter Property="Background" Value="#FFFF8200" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Struct">
                    <Setter Property="Background" Value="#FF245A9E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Component">
                    <Setter Property="Background" Value="#FF2E6B5B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Defaults">
                    <Setter Property="Background" Value="#FF8A5A1E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Branch">
                    <Setter Property="Background" Value="#FF6E6E6E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Flow">
                    <Setter Property="Background" Value="#FF5C5C5C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Return">
                    <Setter Property="Background" Value="#FF6B3FA0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NodeCard" TargetType="Border">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource {x:Static adonisUi:Brushes.Layer4BackgroundBrush}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static adonisUi:Brushes.Layer3BorderBrush}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanJump}" Value="True">
                    <Setter Property="Cursor" Value="Hand" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static adonisUi:Brushes.AlertBrush}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFF0F0F0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EdgePath" TargetType="Path">
            <Setter Property="StrokeThickness" Value="2.5" />
            <Setter Property="Opacity" Value=".9" />
            <Setter Property="Stroke" Value="#FFE8E8E8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Data">
                    <Setter Property="StrokeThickness" Value="1.6" />
                    <Setter Property="Stroke" Value="#FF6FB2E8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- one pin row, the builder places the wires on these fixed heights -->
        <DataTemplate x:Key="PinGlyph" DataType="{x:Type viewModels:BlueprintPin}">
            <Grid Width="12" Height="12">
                <Path x:Name="Exec" Data="M 1,1 L 7,1 L 11,6 L 7,11 L 1,11 Z" Fill="#FFE8E8E8" Visibility="Collapsed" />
                <Ellipse x:Name="Data" Width="9" Height="9" Fill="#FF6FB2E8" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExec}" Value="True">
                    <Setter TargetName="Exec" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Data" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="InputPin" DataType="{x:Type viewModels:BlueprintPin}">
            <StackPanel Orientation="Horizontal" Height="18" Margin="-6 0 0 0">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PinGlyph}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontSize="11" Margin="3 0 0 0" VerticalAlignment="Center" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                <Border x:Name="ValueBox" Margin="4 1 0 1" Padding="3 0" CornerRadius="2" Background="#FF1E1F24" Visibility="Collapsed">
                    <TextBlock Text="{Binding Value}" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasValue}" Value="True">
                    <Setter TargetName="ValueBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="OutputPin" DataType="{x:Type viewModels:BlueprintPin}">
            <StackPanel Orientation="Horizontal" Height="18" HorizontalAlignment="Right" Margin="0 0 -6 0">
                <TextBlock Text="{Binding Name}" FontSize="11" Margin="0 0 3 0" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PinGlyph}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </adonisControls:AdonisWindow.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="160" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- function list -->
        <DockPanel Grid.Column="0">
            <TextBlock x:Name="ClassText" DockPanel.Dock="Top" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2 0 0 4" />
            <TextBox x:Name="FunctionFilter" DockPanel.Dock="Top" Margin="0 0 0 6" TextChanged="OnFunctionFilterChanged"
                     adonisExtensions:WatermarkExtension.Watermark="{DynamicResource UI_BlueprintGraph_FilterFunctions}" />
            <ListBox x:Name="FunctionList" SelectionChanged="OnFunctionSelected"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:BlueprintFunctionGraph}">
                        <StackPanel Margin="0 1" ToolTip="{Binding Signature}">
                            <TextBlock x:Name="FunctionName" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Note}" FontSize="10" Opacity=".55" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsUbergraph}" Value="True">
                                <Setter TargetName="FunctionName" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEventStub}" Value="True">
                                <Setter TargetName="FunctionName" Property="Opacity" Value=".6" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsClassView}" Value="True">
                                <Setter TargetName="FunctionName" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInherited}" Value="True">
                                <Setter TargetName="FunctionName" Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="120" MinHeight="40" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0 0 0 6">
                <Button DockPanel.Dock="Right" Padding="10 3" Margin="6 0 0 0" Click="OnResetZoomClick"
                        Content="{DynamicResource UI_MaterialGraph_ResetZoom}" />
                <Button DockPanel.Dock="Right" Padding="10 3" Margin="6 0 0 0" Click="OnFitClick"
                        Content="{DynamicResource UI_BlueprintGraph_Fit}" />
                <Button DockPanel.Dock="Right" Padding="10 3" Margin="6 0 0 0" Click="OnZoomInClick" Content="+" />
                <Button DockPanel.Dock="Right" Padding="10 3" Margin="6 0 0 0" Click="OnZoomOutClick" Content="-" />
                <TextBox x:Name="NodeSearch" DockPanel.Dock="Right" Width="220" Margin="6 0 0 0" KeyDown="OnNodeSearchKeyDown"
                         TextChanged="OnNodeSearchChanged"
                         adonisExtensions:WatermarkExtension.Watermark="{DynamicResource UI_BlueprintGraph_FindNode}" />
                <TextBlock x:Name="NoteText" VerticalAlignment="Center" Opacity=".75" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <ScrollViewer x:Name="GraphScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="OnGraphMouseWheel" BorderThickness="1"
                          BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer3BorderBrush}}"
                          Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}">
                <Grid x:Name="GraphRoot" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"
                      MouseLeftButtonDown="OnPanStart" MouseMove="OnPanMove" MouseLeftButtonUp="OnPanEnd">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="GraphScale" ScaleX="1" ScaleY="1" />
                    </Grid.LayoutTransform>

                    <ItemsControl x:Name="EdgeItems" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:BlueprintGraphEdge}">
                                <Canvas>
                                    <Path Data="{Binding Geometry}" Style="{StaticResource EdgePath}" />
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl x:Name="NodeItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:BlueprintGraphNode}">
                                <Border Style="{StaticResource NodeCard}" Width="{Binding Width}" Height="{Binding Height}"
                                        MouseLeftButtonDown="OnNodeClick" ToolTip="{Binding Code}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource NodeHeader}" Height="{Binding HeaderHeight}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="White" Opacity=".7" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </Trigger>
                                                                <Trigger Property="Text" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Grid Margin="0 4">
                                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Opacity=".45" IsHitTestVisible="False"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource InputPin}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <ItemsControl ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource OutputPin}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

            <TextBox x:Name="CodeText" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

            <TextBlock x:Name="Status" Grid.Row="4" Margin="2 6 2 0" Opacity=".7" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</adonisControls:AdonisWindow>
