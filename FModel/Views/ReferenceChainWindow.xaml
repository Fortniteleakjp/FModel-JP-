<adonisControls:AdonisWindow x:Class="FModel.Views.ReferenceChainWindow"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"

                             xmlns:local="clr-namespace:FModel.Views"
                             xmlns:inputs="clr-namespace:FModel.Views.Resources.Controls.Inputs"
                             xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
                             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"

                             WindowStartupLocation="CenterScreen" ResizeMode="CanResize" IconVisibility="Collapsed"
                             Height="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenHeight}, Converter={converters:RatioConverter}, ConverterParameter='0.75'}"
                             Width="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenWidth}, Converter={converters:RatioConverter}, ConverterParameter='0.70'}">
    <adonisControls:AdonisWindow.Style>
        <Style TargetType="adonisControls:AdonisWindow" BasedOn="{StaticResource {x:Type adonisControls:AdonisWindow}}">
            <Setter Property="Title" Value="{DynamicResource UI_ReferenceViewer}" />
        </Style>
    </adonisControls:AdonisWindow.Style>

    <adonisControls:AdonisWindow.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:ReferenceChainWindow.FindCommand}" />
    </adonisControls:AdonisWindow.InputBindings>

    <adonisControls:AdonisWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!-- ズームアウト用の -->
            <Geometry x:Key="MinusIcon">M19,13H5V11H19V13Z</Geometry>

            <!-- ツールバーのキャプション -->
            <Style x:Key="ToolbarCaption" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0 0 6 0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}" />
            </Style>

            <!-- 空欄のときは行ごと隠す -->
            <Style x:Key="NodeSubText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ノードのカード -->
            <Style x:Key="ReferenceNodeCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource {x:Static adonisUi:Brushes.Layer4BackgroundBrush}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static adonisUi:Brushes.Layer3BorderBrush}}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Effect" Value="{StaticResource ShadowEffect}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static adonisUi:Brushes.Layer1InteractionBorderBrush}}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static adonisUi:Brushes.AccentBrush}}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </adonisControls:AdonisWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダーとツールバー -->
        <Grid Grid.Row="0" Margin="10 10 10 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding NodeCount, Mode=OneWay, FallbackValue=0}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource UI_Nodes}" FontSize="10"
                           Foreground="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}" />

                <Rectangle Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="1" Margin="16 2"
                           Fill="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}" />

                <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" TextWrapping="Wrap" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}">
                    <Run Text="{Binding RootLabel, Mode=OneWay}"
                         Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" />
                    <LineBreak />
                    <Run Text="{DynamicResource UI_ReferenceViewerHint}" />
                </TextBlock>
            </Grid>

            <Separator Grid.Row="1" Style="{StaticResource CustomSeparator}" Tag="OPTIONS" Margin="0 5" />

            <Grid Grid.Row="2" Margin="0 0 0 2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{DynamicResource UI_Mode}" Style="{StaticResource ToolbarCaption}" />
                <ComboBox Grid.Column="1" SelectedIndex="{Binding SearchMode}" Width="200" VerticalAlignment="Center" Margin="0 0 12 0">
                    <ComboBoxItem Content="{DynamicResource UI_Dependencies}" />
                    <ComboBoxItem Content="{DynamicResource UI_Referencers}" />
                </ComboBox>

                <TextBlock Grid.Column="2" Text="{DynamicResource UI_Filter}" Style="{StaticResource ToolbarCaption}" />
                <ComboBox Grid.Column="3" SelectedValue="{Binding AssetTypeFilter}" SelectedValuePath="Tag" Width="140" VerticalAlignment="Center" Margin="0 0 12 0">
                    <ComboBoxItem Content="{DynamicResource UI_All}" Tag="All" IsSelected="True" />
                    <ComboBoxItem Content="{DynamicResource UI_Texture}" Tag="Texture" />
                    <ComboBoxItem Content="{DynamicResource UI_Material}" Tag="Material" />
                    <ComboBoxItem Content="{DynamicResource UI_Mesh}" Tag="Mesh" />
                    <ComboBoxItem Content="{DynamicResource UI_Animation}" Tag="Animation" />
                    <ComboBoxItem Content="{DynamicResource UI_Sound}" Tag="Sound" />
                    <ComboBoxItem Content="{DynamicResource UI_Blueprint}" Tag="Blueprint" />
                    <ComboBoxItem Content="{DynamicResource UI_ConfigIni}" Tag="Config (.ini)" />
                </ComboBox>

                <TextBlock Grid.Column="4" Text="{DynamicResource UI_Depth}" Style="{StaticResource ToolbarCaption}" />
                <TextBox Grid.Column="5" Text="{Binding MaxDepth}" Width="46" VerticalAlignment="Center" Margin="0 0 12 0"
                         HorizontalContentAlignment="Center" />

                <Button Grid.Column="6" Click="OnRefreshClick" IsDefault="True" VerticalAlignment="Center" Padding="10 3"
                        Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0 0 6 0">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="{StaticResource ResetIcon}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{DynamicResource UI_Refresh}" VerticalAlignment="Center" Foreground="White" />
                    </StackPanel>
                </Button>

                <inputs:SearchTextBox Grid.Column="8" x:Name="SearchBox" Width="220" VerticalAlignment="Center"
                                      Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Watermark="{DynamicResource UI_SearchByName}"
                                      KeyDown="OnSearchKeyDown" ClearButtonClick="OnSearchCleared" />

                <Button Grid.Column="9" Click="OnPrevSearchClick" VerticalAlignment="Center" Padding="5" Margin="4 0 0 0"
                        ToolTip="{DynamicResource UI_Previous}" Style="{DynamicResource {x:Static adonisUi:Styles.ToolbarButton}}">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource ArrowIcon}">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="180" CenterX="12" CenterY="12" />
                                </Path.RenderTransform>
                            </Path>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Grid.Column="10" Click="OnNextSearchClick" VerticalAlignment="Center" Padding="5"
                        ToolTip="{DynamicResource UI_Next}" Style="{DynamicResource {x:Static adonisUi:Styles.ToolbarButton}}">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource ArrowIcon}" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Grid>

        <!-- グラフ -->
        <GroupBox Grid.Row="1" Margin="10 8 10 0" adonisExtensions:LayerExtension.Layer="2"
                  Padding="{adonisUi:Space 0}" Background="Transparent">
            <Grid ClipToBounds="True">
                <ScrollViewer x:Name="MainScrollViewer"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="None"
                              Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}"
                              PreviewMouseWheel="OnPreviewMouseWheel"
                              PreviewMouseLeftButtonDown="OnScrollViewerMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="OnScrollViewerMouseLeftButtonUp"
                              PreviewMouseMove="OnScrollViewerMouseMove">
                    <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Margin="100">
                        <Grid.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Stretch="None">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="{DynamicResource {x:Static adonisUi:Brushes.Layer3BorderBrush}}">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry Center="0,0" RadiusX="1" RadiusY="1" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Grid.Background>
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
                        </Grid.LayoutTransform>

                        <!-- 接続線 -->
                        <ItemsControl ItemsSource="{Binding Connections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Path Data="{Binding CurveData}" Stroke="{Binding Target.AccentBrush}"
                                          StrokeThickness="1.5" Opacity="0.55" StrokeEndLineCap="Round" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ノード -->
                        <ItemsControl x:Name="NodesItemsControl" ItemsSource="{Binding FlatNodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="250" Height="80" Style="{StaticResource ReferenceNodeCard}" Cursor="Hand"
                                            MouseLeftButtonDown="OnNodeMouseLeftButtonDown"
                                            MouseLeftButtonUp="OnNodeMouseLeftButtonUp"
                                            MouseMove="OnNodeMouseMove">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource UI_OpenAsset}" Click="OnOpenAssetClick">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="16" Height="16">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource GoToIcon}" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{DynamicResource UI_CopyPath}" Click="OnCopyPathClick">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="16" Height="16">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource CopyIcon}" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- アセット種別の色帯 -->
                                            <Border Grid.Column="0" Background="{Binding AccentBrush}" CornerRadius="3 0 0 3" />

                                            <Grid Grid.Column="1" Margin="8 6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0" Width="20" Height="20" Margin="0 0 8 0">
                                                        <Image Stretch="Uniform" Source="{Binding PreviewImage}" />
                                                        <Path Stretch="Uniform" Data="{Binding IconData}" Fill="{Binding AccentBrush}">
                                                            <Path.Style>
                                                                <Style TargetType="{x:Type Path}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Grid>

                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                               FontSize="13" FontWeight="DemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" />
                                                </Grid>

                                                <TextBlock Grid.Row="1" Text="{Binding TypeName}" Margin="0 4 0 0" Style="{StaticResource NodeSubText}" />
                                                <TextBlock Grid.Row="2" Text="{Binding Path}" Margin="0 2 0 0" TextWrapping="Wrap"
                                                           Style="{StaticResource NodeSubText}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <!-- 結果なし -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Viewbox Width="48" Height="48" Opacity="0.35" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource MagnifierIcon}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource UI_NoReferencesFoundInOtherPackages}" Margin="0 10 0 0" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ステータスバー -->
        <Border Grid.Row="2" Margin="0 8 0 0" MinHeight="30"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                adonisExtensions:LayerExtension.IncreaseLayer="True">
            <Grid Margin="10 4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0" Width="120" Height="6" VerticalAlignment="Center" Margin="0 0 10 0"
                             Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding SearchStatus}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Text" Value="{Binding ProgressText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" MinWidth="42" TextAlignment="Right"
                           Text="{Binding ZoomScale, StringFormat={}{0:P0}}"
                           Foreground="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8 0 0 0">
                    <Button Click="OnZoomOutClick" Padding="4" ToolTip="{DynamicResource UI_ZoomOut}"
                            Style="{DynamicResource {x:Static adonisUi:Styles.ToolbarButton}}">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource MinusIcon}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Click="OnZoomInClick" Padding="4" ToolTip="{DynamicResource UI_ZoomIn}"
                            Style="{DynamicResource {x:Static adonisUi:Styles.ToolbarButton}}">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource AddIcon}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Click="OnResetViewClick" Padding="4" ToolTip="{DynamicResource UI_ResetView}"
                            Style="{DynamicResource {x:Static adonisUi:Styles.ToolbarButton}}">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" Data="{StaticResource LocateMeIcon}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</adonisControls:AdonisWindow>
