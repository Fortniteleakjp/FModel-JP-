<adonisControls:AdonisWindow x:Class="FModel.Views.PakCreatorWindow"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
                             WindowStartupLocation="CenterScreen" ResizeMode="CanResize" IconVisibility="Collapsed"
                             Width="760" Height="760" MinWidth="600" MinHeight="560">
    <adonisControls:AdonisWindow.Style>
        <Style TargetType="adonisControls:AdonisWindow" BasedOn="{StaticResource {x:Type adonisControls:AdonisWindow}}">
            <Setter Property="Title" Value="{DynamicResource UI_PakCreator}" />
        </Style>
    </adonisControls:AdonisWindow.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="12 10 12 4" TextWrapping="Wrap" Text="{DynamicResource UI_PakCreatorDescription}" />

        <GroupBox Grid.Row="1" Margin="10 6" adonisExtensions:LayerExtension.Layer="2" Padding="{adonisUi:Space 1}" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource UI_PakSource}" />
                <TextBox x:Name="SourceBox" Grid.Row="0" Grid.Column="2" TextChanged="OnSourceChanged" />
                <Button Grid.Row="0" Grid.Column="3" Margin="6 0 0 0" Padding="10 2" Content="{DynamicResource UI_Browse}" Click="OnBrowseSource" />

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource UI_PakOutput}" />
                <TextBox x:Name="OutputBox" Grid.Row="2" Grid.Column="2" />
                <Button Grid.Row="2" Grid.Column="3" Margin="6 0 0 0" Padding="10 2" Content="{DynamicResource UI_Browse}" Click="OnBrowseOutput" />

                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource UI_PakVersionAndMount}" />
                <StackPanel Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <ComboBox x:Name="VersionBox" Width="260">
                        <ComboBoxItem Tag="3" Content="v3（u4pak と同じ・UE4.13 以降）" />
                        <ComboBoxItem Tag="7" Content="v7（UE4.20 以降）" />
                    </ComboBox>
                    <TextBlock Margin="14 0 6 0" VerticalAlignment="Center" Text="{DynamicResource UI_PakMountPoint}" />
                    <TextBox x:Name="MountBox" Width="140" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Margin="10 0 10 6" adonisExtensions:LayerExtension.Layer="2" Padding="{adonisUi:Space 1}" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="RegistryCheck" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Content="{DynamicResource UI_PakMergeRegistry}"
                          ToolTip="{DynamicResource UI_PakMergeRegistryDescription}" Checked="OnRegistryToggled" Unchecked="OnRegistryToggled" />

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource UI_PakRegistryBase}" />
                <ComboBox x:Name="RegistryBaseBox" Grid.Row="2" Grid.Column="2" IsEditable="True" ToolTip="{DynamicResource UI_PakRegistryBaseDescription}"
                          LostFocus="OnRegistryBaseChanged" SelectionChanged="OnRegistryBaseChanged" />
                <Button x:Name="RegistryBaseBrowse" Grid.Row="2" Grid.Column="3" Margin="6 0 0 0" Padding="10 2" Content="{DynamicResource UI_Browse}" Click="OnBrowseRegistryBase" />

                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource UI_PakRegistrySource}" />
                <TextBox x:Name="RegistrySourceBox" Grid.Row="4" Grid.Column="2" ToolTip="{DynamicResource UI_PakRegistrySourceDescription}" />
                <Button x:Name="RegistrySourceBrowse" Grid.Row="4" Grid.Column="3" Margin="6 0 0 0" Padding="10 2" Content="{DynamicResource UI_Browse}" Click="OnBrowseRegistrySource" />

                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource UI_PakRegistryFilter}" />
                <TextBox x:Name="RegistryFilterBox" Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2" ToolTip="{DynamicResource UI_PakRegistryFilterDescription}" />

                <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource UI_PakRegistryName}" />
                <TextBox x:Name="RegistryNameBox" Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="2" ToolTip="{DynamicResource UI_PakRegistryNameDescription}" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Margin="10 0 10 6" adonisExtensions:LayerExtension.Layer="2" Padding="{adonisUi:Space 1}" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="SignatureCheck" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Content="{DynamicResource UI_PakWriteSignature}"
                          ToolTip="{DynamicResource UI_PakWriteSignatureDescription}" Checked="OnSignatureToggled" Unchecked="OnSignatureToggled" />

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource UI_PakSignatureTemplate}" />
                <TextBox x:Name="SignatureTemplateBox" Grid.Row="2" Grid.Column="2" ToolTip="{DynamicResource UI_PakSignatureTemplateDescription}" />
                <Button x:Name="SignatureTemplateBrowse" Grid.Row="2" Grid.Column="3" Margin="6 0 0 0" Padding="10 2" Content="{DynamicResource UI_Browse}" Click="OnBrowseSignatureTemplate" />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="4" Margin="10 0 10 6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="SummaryText" Grid.Row="0" Margin="2 0 0 4" />
            <ListBox x:Name="FileList" Grid.Row="1" FontFamily="Consolas" FontSize="11"
                     VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Grid>

        <Border Grid.Row="5" Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                adonisExtensions:LayerExtension.IncreaseLayer="True">
            <Grid Margin="12 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="CreateButton" Grid.Column="1" Margin="10 0 0 0" Padding="14 4" IsDefault="True"
                        Content="{DynamicResource UI_PakCreate}" Click="OnCreate" />
                <Button Grid.Column="2" Margin="8 0 0 0" Padding="14 4" IsCancel="True" Content="{DynamicResource UI_Close}" Click="OnClose" />
            </Grid>
        </Border>
    </Grid>
</adonisControls:AdonisWindow>
