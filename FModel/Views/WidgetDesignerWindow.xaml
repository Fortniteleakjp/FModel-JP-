<adonisControls:AdonisWindow x:Class="FModel.Views.WidgetDesignerWindow"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"

                             xmlns:local="clr-namespace:FModel.Views"
                             xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
                             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"

                             WindowStartupLocation="CenterScreen" ResizeMode="CanResize" IconVisibility="Collapsed"
                             Height="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenHeight}, Converter={converters:RatioConverter}, ConverterParameter='0.8'}"
                             Width="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenWidth}, Converter={converters:RatioConverter}, ConverterParameter='0.85'}">
    <adonisControls:AdonisWindow.Style>
        <Style TargetType="adonisControls:AdonisWindow" BasedOn="{StaticResource {x:Type adonisControls:AdonisWindow}}">
            <Setter Property="Title" Value="{DynamicResource UI_WidgetDesigner}" />
        </Style>
    </adonisControls:AdonisWindow.Style>

    <adonisControls:AdonisWindow.Resources>
        <!-- the UMG designer's dark checker-less grid -->
        <DrawingBrush x:Key="DesignerGrid" TileMode="Tile" Viewport="0 0 100 100" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF242424">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0 0 100 100" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FF2C2C2C" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="25 0" EndPoint="25 100" />
                                <LineGeometry StartPoint="50 0" EndPoint="50 100" />
                                <LineGeometry StartPoint="75 0" EndPoint="75 100" />
                                <LineGeometry StartPoint="0 25" EndPoint="100 25" />
                                <LineGeometry StartPoint="0 50" EndPoint="100 50" />
                                <LineGeometry StartPoint="0 75" EndPoint="100 75" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FF343434" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0 0" EndPoint="0 100" />
                                <LineGeometry StartPoint="0 0" EndPoint="100 0" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </adonisControls:AdonisWindow.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="160" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="360" MinWidth="160" />
        </Grid.ColumnDefinitions>

        <!-- toolbar -->
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Margin="0 0 0 6" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0 0 6 0" Text="{DynamicResource UI_WidgetDesigner_ScreenSize}" />
            <ComboBox x:Name="SizePresets" DockPanel.Dock="Left" Width="170" SelectionChanged="OnSizePresetChanged" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10 0 4 0" Text="{DynamicResource UI_WidgetDesigner_Width}" />
            <TextBox x:Name="WidthBox" DockPanel.Dock="Left" Width="60" KeyDown="OnSizeBoxKeyDown" LostFocus="OnSizeBoxLostFocus" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8 0 4 0" Text="{DynamicResource UI_WidgetDesigner_Height}" />
            <TextBox x:Name="HeightBox" DockPanel.Dock="Left" Width="60" KeyDown="OnSizeBoxKeyDown" LostFocus="OnSizeBoxLostFocus" />

            <Button DockPanel.Dock="Right" Padding="10 3" Margin="6 0 0 0" Click="OnFitClick" Content="{DynamicResource UI_BlueprintGraph_Fit}" />
            <Button DockPanel.Dock="Right" Padding="10 3" Margin="6 0 0 0" Click="OnActualSizeClick" Content="100%" />
            <CheckBox x:Name="OutlinesCheck" DockPanel.Dock="Right" Margin="12 0 0 0" VerticalAlignment="Center" IsChecked="True"
                      Content="{DynamicResource UI_WidgetDesigner_Outlines}" Checked="OnOutlinesChanged" Unchecked="OnOutlinesChanged" />
            <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12 0 0 0" Opacity=".7" />
            <TextBlock x:Name="NoteText" VerticalAlignment="Center" Margin="16 0 0 0" Opacity=".7" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- hierarchy -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="FilterBox" Grid.Row="0" Margin="0 0 0 4" TextChanged="OnFilterChanged"
                     adonisExtensions:WatermarkExtension.Watermark="{DynamicResource UI_WidgetDesigner_Filter}" />
            <TreeView x:Name="HierarchyTree" Grid.Row="1" SelectedItemChanged="OnTreeSelectionChanged" BorderThickness="1"
                      BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer3BorderBrush}}"
                      Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeViewItemStyle}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Visibility" Value="{Binding Visibility}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:UmgTreeItem}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                            <Border Width="18" Height="18" CornerRadius="3" Margin="0 0 6 0" Background="{Binding KindBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindGlyph}" FontSize="11" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                       FontStyle="{Binding NameStyle}" Opacity="{Binding NameOpacity}" />
                            <TextBlock Text="{Binding ClassName}" Margin="8 0 0 0" Opacity=".55" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- designer surface -->
        <Border Grid.Row="1" Grid.Column="2" BorderThickness="1" ClipToBounds="True"
                BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer3BorderBrush}}">
            <Grid x:Name="Viewport" Background="{StaticResource DesignerGrid}" ClipToBounds="True" Focusable="True"
                  MouseWheel="OnViewportMouseWheel" MouseDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove"
                  MouseUp="OnViewportMouseUp" SizeChanged="OnViewportSizeChanged">
                <Canvas x:Name="Stage">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="StageScale" />
                            <TranslateTransform x:Name="StageTranslate" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <!-- the design area: dashed frame around the widget, like the UMG designer -->
                    <Grid x:Name="DesignFrame">
                        <Border x:Name="DesignHost" ClipToBounds="True" />
                        <Rectangle x:Name="FrameRect" Stroke="#FF35A9FF" StrokeThickness="1" StrokeDashArray="4 3" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                    </Grid>
                </Canvas>
                <!-- screen space overlay: outlines and selection, drawn at a constant thickness whatever the zoom -->
                <Canvas x:Name="Overlay" IsHitTestVisible="False" />
                <TextBlock x:Name="SizeText" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10 6" Foreground="#80FFFFFF"
                           FontSize="16" FontWeight="SemiBold" IsHitTestVisible="False" />
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A0FFFFFF"
                           Visibility="Collapsed" Text="{DynamicResource UI_WidgetDesigner_Empty}" />
            </Grid>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- details -->
        <Grid Grid.Row="1" Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="2 0 2 6">
                <TextBlock x:Name="DetailName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailClass" Opacity=".6" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailSummary" Margin="0 4 0 0" TextWrapping="Wrap" Opacity=".85" />
            </StackPanel>
            <TextBox x:Name="DetailJson" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     AcceptsReturn="True" VerticalContentAlignment="Top" />
        </Grid>

        <TextBlock x:Name="Status" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="2 6 2 0" Opacity=".7" TextTrimming="CharacterEllipsis" />
    </Grid>
</adonisControls:AdonisWindow>
