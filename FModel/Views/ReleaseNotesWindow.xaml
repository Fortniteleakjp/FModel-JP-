<adonisControls:AdonisWindow x:Class="FModel.Views.ReleaseNotesWindow"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"

                             xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
                             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"

                             WindowStartupLocation="CenterScreen" ResizeMode="CanResize" IconVisibility="Collapsed"
                             Loaded="OnLoaded"
                             Height="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenHeight}, Converter={converters:RatioConverter}, ConverterParameter='0.62'}"
                             Width="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenWidth}, Converter={converters:RatioConverter}, ConverterParameter='0.55'}">
    <adonisControls:AdonisWindow.Style>
        <Style TargetType="adonisControls:AdonisWindow" BasedOn="{StaticResource {x:Type adonisControls:AdonisWindow}}">
            <Setter Property="Title" Value="{DynamicResource UI_ReleaseNotes}" />
        </Style>
    </adonisControls:AdonisWindow.Style>

    <adonisControls:AdonisWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!-- 変更種別のバッジ -->
            <Style x:Key="ChangeBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Padding" Value="6 1" />
                <Setter Property="Margin" Value="0 1 8 0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="Background" Value="#528BCC" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Type}" Value="Added">
                        <Setter Property="Background" Value="#98C379" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Type}" Value="Fixed">
                        <Setter Property="Background" Value="#E5C07B" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Type}" Value="Removed">
                        <Setter Property="Background" Value="#E06C75" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SubText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}" />
            </Style>
        </ResourceDictionary>
    </adonisControls:AdonisWindow.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- バージョン一覧 -->
        <GroupBox Grid.Column="0" Header="{DynamicResource UI_Version}" Padding="{adonisUi:Space 0}"
                  adonisExtensions:LayerExtension.IncreaseLayer="True">
            <ListBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}"
                     HorizontalContentAlignment="Stretch" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2 4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayVersion}" FontWeight="DemiBold" FontSize="13"
                                           Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" />
                                <Border Background="{DynamicResource {x:Static adonisUi:Brushes.Layer3BackgroundBrush}}"
                                        CornerRadius="3" Padding="4 0" Margin="6 0 0 0" VerticalAlignment="Center"
                                        Visibility="{Binding IsFromGitHub, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="GitHub" Style="{StaticResource SubText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding DisplayDate}" Style="{StaticResource SubText}" Margin="0 2 0 0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- 選択されたリリースの内容 -->
        <GroupBox Grid.Column="1" Margin="10 0 0 0" Header="{DynamicResource UI_ReleaseNotes}"
                  adonisExtensions:LayerExtension.IncreaseLayer="True">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              DataContext="{Binding SelectedRelease}">
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding DisplayTitle}" FontSize="17" FontWeight="DemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" />

                        <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                            <TextBlock Text="{Binding DisplayVersion}" Style="{StaticResource SubText}" />
                            <TextBlock Text=" · " Style="{StaticResource SubText}" />
                            <TextBlock Text="{Binding DisplayDate}" Style="{StaticResource SubText}" />
                        </StackPanel>

                        <TextBlock Margin="0 6 0 0" Visibility="{Binding IsFromGitHub, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Hyperlink NavigateUri="{Binding HtmlUrl}" RequestNavigate="OnRequestNavigate">
                                <TextBlock Text="{DynamicResource UI_ViewOnGitHub}" FontSize="11" />
                            </Hyperlink>
                        </TextBlock>

                        <Separator Margin="0 10" />

                        <!-- 同梱分: 種別付きの変更一覧 -->
                        <ItemsControl ItemsSource="{Binding Changes}"
                                      Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0 0 0 8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource ChangeBadge}">
                                            <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="DemiBold"
                                                       TextAlignment="Center" Foreground="#1B1B1B" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Display}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- GitHub 分: リリース本文をそのまま表示 -->
                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas"
                                   Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                                   Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 読み込み中 / 空 -->
                <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="{DynamicResource UI_NoReleaseNotes}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource SubText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </GroupBox>
    </Grid>
</adonisControls:AdonisWindow>
