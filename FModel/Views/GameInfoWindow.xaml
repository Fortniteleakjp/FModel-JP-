<adonisControls:AdonisWindow x:Class="FModel.Views.GameInfoWindow"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"

                             xmlns:gameInfo="clr-namespace:FModel.Services.GameInfo"
                             xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
                             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"

                             WindowStartupLocation="CenterScreen" ResizeMode="CanResize" IconVisibility="Collapsed"
                             Loaded="OnLoaded" Closing="OnClosing"
                             Height="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenHeight}, Converter={converters:RatioConverter}, ConverterParameter='0.7'}"
                             Width="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenWidth}, Converter={converters:RatioConverter}, ConverterParameter='0.55'}">
    <adonisControls:AdonisWindow.Style>
        <Style TargetType="adonisControls:AdonisWindow" BasedOn="{StaticResource {x:Type adonisControls:AdonisWindow}}">
            <Setter Property="Title" Value="{DynamicResource UI_GameInfo}" />
        </Style>
    </adonisControls:AdonisWindow.Style>

    <adonisControls:AdonisWindow.Resources>
        <!-- 1 行 = 項目名 + 値 (+ 補足)。値は選択してコピーできるよう読み取り専用の TextBox にする -->
        <DataTemplate x:Key="InfoRowTemplate" DataType="{x:Type gameInfo:InfoRow}">
            <Grid Margin="0 1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabel" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Margin="0 2 16 0" Opacity=".65" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                    <TextBox x:Name="ValueBox" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Padding="0"
                             Background="Transparent" TextWrapping="Wrap" />
                    <TextBlock x:Name="NoteText" Text="{Binding Note}" FontSize="11" Opacity=".55" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static gameInfo:InfoSeverity.Warning}">
                    <Setter TargetName="ValueBox" Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Brushes.AlertBrush}}" />
                    <Setter TargetName="NoteText" Property="Opacity" Value=".85" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static gameInfo:InfoSeverity.Good}">
                    <Setter TargetName="ValueBox" Property="Foreground" Value="{DynamicResource {x:Static adonisUi:Brushes.SuccessBrush}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                    <Setter TargetName="NoteText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="InfoSectionTemplate" DataType="{x:Type gameInfo:InfoSection}">
            <StackPanel Margin="0 0 0 14">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0 0 0 4" />
                <Border Height="1" Margin="0 0 0 6" Background="{DynamicResource {x:Static adonisUi:Brushes.Layer3BorderBrush}}" />
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="WarningTemplate">
            <TextBlock Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" Margin="0 0 0 2"
                       Foreground="{DynamicResource {x:Static adonisUi:Brushes.AlertBrush}}" />
        </DataTemplate>
    </adonisControls:AdonisWindow.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0">
            <TabItem x:Name="GameTab" Header="ゲーム・UE バージョン">
                <DockPanel Margin="4 8 4 4">
                    <DockPanel DockPanel.Dock="Top" Margin="0 0 0 8">
                        <Button x:Name="CopyReportButton" DockPanel.Dock="Right" Padding="10 3" Margin="6 0 0 0" Click="OnCopyReportClick"
                                Content="テキストでコピー" IsEnabled="False" />
                        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Padding="10 3" Margin="6 0 0 0" Click="OnRefreshClick"
                                Content="再読み込み" />
                        <TextBlock Text="読み込み中のゲームの UE バージョンを、FModel の設定・実行ファイル・パッケージ・アーカイブ・マッピングから調べます。"
                                   TextWrapping="Wrap" Opacity=".7" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl x:Name="ReportWarnings" DockPanel.Dock="Top" Margin="0 0 0 8" ItemTemplate="{StaticResource WarningTemplate}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.IsSharedSizeScope="True">
                        <ItemsControl x:Name="ReportSections" ItemTemplate="{StaticResource InfoSectionTemplate}" Margin="0 0 8 0" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="MappingTab" Header="マッピング">
                <Grid Margin="4 8 4 4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0 0 0 8">
                        <Button x:Name="UseLoadedMappingButton" DockPanel.Dock="Right" Padding="10 3" Margin="6 0 0 0" Click="OnUseLoadedMappingClick"
                                Content="読み込み中のマッピング" />
                        <Button x:Name="OpenMappingButton" DockPanel.Dock="Right" Padding="10 3" Margin="6 0 0 0" Click="OnOpenMappingClick"
                                Content="ファイルを開く…" />
                        <TextBlock x:Name="MappingSourceText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity=".7" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" MaxHeight="260" Margin="0 0 0 4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Grid.IsSharedSizeScope="True">
                        <ItemsControl x:Name="MappingHeaderSection" ItemTemplate="{StaticResource InfoSectionTemplate}" Margin="0 0 8 0" />
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" MinWidth="220" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" MinWidth="240" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <DockPanel DockPanel.Dock="Top" Margin="0 0 0 6">
                                <ComboBox x:Name="KindFilter" DockPanel.Dock="Right" Width="96" Margin="6 0 0 0" SelectedIndex="0" SelectionChanged="OnKindFilterChanged">
                                    <ComboBoxItem Content="すべて" />
                                    <ComboBoxItem Content="構造体" />
                                    <ComboBoxItem Content="列挙型" />
                                </ComboBox>
                                <TextBox x:Name="TypeFilterBox" Padding="4 2" TextChanged="OnTypeFilterTextChanged"
                                         adonisExtensions:WatermarkExtension.Watermark="型名で絞り込み (スペース区切りで AND)" />
                            </DockPanel>
                            <TextBlock x:Name="TypeCountText" DockPanel.Dock="Bottom" Margin="2 4 0 0" Opacity=".6" />
                            <ListBox x:Name="TypeList" BorderThickness="1" SelectionChanged="OnTypeSelected"
                                     BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer3BorderBrush}}"
                                     Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type gameInfo:MappingTypeEntry}">
                                        <DockPanel ToolTip="{Binding Summary}">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Kind}" Width="44" FontSize="11" Opacity=".55" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11" Opacity=".55" Margin="6 0 0 0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" ResizeDirection="Columns"
                                      Background="{DynamicResource {x:Static adonisUi:Brushes.Layer3BackgroundBrush}}" />

                        <DockPanel Grid.Column="2" Margin="4 0 0 0">
                            <DockPanel DockPanel.Dock="Top" Margin="0 0 0 6">
                                <Button x:Name="CopyTypeButton" DockPanel.Dock="Right" Padding="10 3" Margin="6 0 0 0" Click="OnCopyTypeClick"
                                        Content="コピー" IsEnabled="False" />
                                <TextBlock x:Name="SelectedTypeText" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBox x:Name="TypeDetailBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                     TextWrapping="NoWrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="Status" Grid.Row="1" Margin="2 6 2 0" Opacity=".7" TextTrimming="CharacterEllipsis" />
    </Grid>
</adonisControls:AdonisWindow>
