<adonisControls:AdonisWindow x:Class="FModel.Views.UpdateDownloadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
        xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
        Title="{Binding Title}"
        Height="190" Width="460"
        MinWidth="460" MinHeight="190"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Closing="OnClosing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Message}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <ProgressBar Grid.Row="1"
                     Height="20"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding Progress}"
                     IsIndeterminate="{Binding IsIndeterminate}" />

        <TextBlock Grid.Row="2"
                   Text="{Binding DownloadedText}"
                   HorizontalAlignment="Right"
                   Margin="0,6,0,12" />

        <Button Grid.Row="3"
                Content="キャンセル"
                Command="{Binding CancelCommand}"
                IsEnabled="{Binding IsCancelling, Converter={x:Static converters:InvertBooleanConverter.Instance}}"
                HorizontalAlignment="Center"
                MinWidth="100"
                Padding="12,5" />
    </Grid>
</adonisControls:AdonisWindow>
